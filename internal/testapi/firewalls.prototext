}
message_type {
  name: "Key"
  # A project's keys, and the public ones, which are read by name only.
  options { [google.api.resource] { type: "keys.origincloudapis.eu/Key" pattern: "keys/{key}" pattern: "projects/{project}/keys/{key}" singular: "key" plural: "keys" } }
  field { name: "name" number: 1 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "name" options { [google.api.field_behavior]: IDENTIFIER } }
  field { name: "create_time" number: 2 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".google.protobuf.Timestamp" json_name: "createTime" options { [google.api.field_behavior]: OUTPUT_ONLY } }
  field { name: "expire_time" number: 3 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".google.protobuf.Timestamp" json_name: "expireTime" options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "rotation_period" number: 4 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".google.protobuf.Duration" json_name: "rotationPeriod" options { [google.api.field_behavior]: OPTIONAL } }
  # In the create's response only (a secret).
  field { name: "secret" number: 5 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "secret" options { [google.api.field_behavior]: OUTPUT_ONLY } }
  field { name: "state" number: 6 label: LABEL_OPTIONAL type: TYPE_ENUM type_name: ".test.firewalls.v1.Key.State" json_name: "state" options { [google.api.field_behavior]: OUTPUT_ONLY } }
  # Explicit presence: the API chooses the value left out.
  field { name: "algorithm" number: 7 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "algorithm" oneof_index: 3 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "bits" number: 8 label: LABEL_OPTIONAL type: TYPE_INT32 json_name: "bits" oneof_index: 4 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
  # A oneof, which may be left unset.
  field { name: "seed" number: 9 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "seed" oneof_index: 0 options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "imported" number: 10 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".test.firewalls.v1.Origin" json_name: "imported" oneof_index: 0 options { [google.api.field_behavior]: OPTIONAL } }
  # A oneof one of whose members must be set.
  field { name: "sign" number: 11 label: LABEL_OPTIONAL type: TYPE_BOOL json_name: "sign" oneof_index: 1 options { [google.api.field_behavior]: REQUIRED } }
  field { name: "encrypt" number: 12 label: LABEL_OPTIONAL type: TYPE_BOOL json_name: "encrypt" oneof_index: 1 options { [google.api.field_behavior]: REQUIRED } }
  # Immutable, and written in any time zone.
  field { name: "not_before" number: 13 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".google.protobuf.Timestamp" json_name: "notBefore" options { [google.api.field_behavior]: IMMUTABLE } }
  # Sets, mutable and immutable, of elements with a field with presence.
  field { name: "pools" number: 15 label: LABEL_REPEATED type: TYPE_MESSAGE type_name: ".test.firewalls.v1.Window" json_name: "pools" options { [google.api.field_behavior]: OPTIONAL [google.api.field_behavior]: UNORDERED_LIST } }
  field { name: "frozen" number: 19 label: LABEL_REPEATED type: TYPE_MESSAGE type_name: ".test.firewalls.v1.Window" json_name: "frozen" options { [google.api.field_behavior]: IMMUTABLE [google.api.field_behavior]: UNORDERED_LIST } }
  # A oneof whose members differ in IMMUTABLE.
  field { name: "zone" number: 16 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "zone" oneof_index: 2 options { [google.api.field_behavior]: IMMUTABLE } }
  field { name: "region" number: 17 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "region" oneof_index: 2 options { [google.api.field_behavior]: OPTIONAL } }
  # A message field marked optional: an object the API may choose.
  field { name: "primary" number: 18 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".test.firewalls.v1.Window" json_name: "primary" oneof_index: 5 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
  oneof_decl { name: "source" }
  oneof_decl { name: "usage" }
  oneof_decl { name: "target" }
  oneof_decl { name: "_algorithm" }
  oneof_decl { name: "_bits" }
  oneof_decl { name: "_primary" }
  enum_type {
    name: "State"
    value { name: "STATE_UNSPECIFIED" number: 0 }
    value { name: "ENABLED" number: 1 }
    value { name: "DISABLED" number: 2 }
    value { name: "TERMINATED" number: 3 }
  }
}
message_type {
  name: "Window"
  field { name: "name" number: 1 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "name" options { [google.api.field_behavior]: REQUIRED } }
  field { name: "weight" number: 2 label: LABEL_OPTIONAL type: TYPE_INT32 json_name: "weight" oneof_index: 0 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
