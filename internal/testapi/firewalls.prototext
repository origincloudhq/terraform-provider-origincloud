    field { name: "value" number: 2 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "value" }
  }
}
message_type {
  name: "Ticket"
  options { [google.api.resource] { type: "vaults.origincloudapis.eu/Ticket" pattern: "vaults/{vault}/tickets/{ticket}" singular: "ticket" plural: "tickets" } }
  field { name: "name" number: 1 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "name" options { [google.api.field_behavior]: IDENTIFIER } }
  field { name: "subject" number: 2 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "subject" options { [google.api.field_behavior]: REQUIRED [google.api.field_behavior]: IMMUTABLE } }
