message_type {
  name: "VaultQuota"
  options { [google.api.resource] { type: "vaults.origincloudapis.eu/VaultQuota" pattern: "vaults/{vault}/quota" singular: "vaultQuota" plural: "vaultQuotas" } }
  field { name: "name" number: 1 label: LABEL_OPTIONAL type: TYPE_STRING json_name: "name" options { [google.api.field_behavior]: IDENTIFIER } }
  # Budgets with presence: the API chooses those left out.
  field { name: "max_secrets" number: 2 label: LABEL_OPTIONAL type: TYPE_INT64 json_name: "maxSecrets" oneof_index: 0 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "max_versions" number: 3 label: LABEL_OPTIONAL type: TYPE_INT64 json_name: "maxVersions" oneof_index: 1 proto3_optional: true options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "usage" number: 4 label: LABEL_OPTIONAL type: TYPE_INT64 json_name: "usage" options { [google.api.field_behavior]: OUTPUT_ONLY } }
  # Repeated and map fields, which can't have presence: a list, a set and
  # a map.
  field { name: "alert_percents" number: 5 label: LABEL_REPEATED type: TYPE_INT32 json_name: "alertPercents" options { [google.api.field_behavior]: OPTIONAL } }
  field { name: "recipients" number: 6 label: LABEL_REPEATED type: TYPE_STRING json_name: "recipients" options { [google.api.field_behavior]: OPTIONAL [google.api.field_behavior]: UNORDERED_LIST } }
  field { name: "labels" number: 7 label: LABEL_REPEATED type: TYPE_MESSAGE type_name: ".test.firewalls.v1.VaultQuota.LabelsEntry" json_name: "labels" options { [google.api.field_behavior]: OPTIONAL } }
